# Cantinas Nexus - modelo de configuração para outro ambiente
#
# Copie os nomes para o gerenciador de Secrets/Environment Variables
# do novo ambiente. Não coloque valores reais neste arquivo versionado.

# Obrigatória para a API e Drizzle.
# Em Replit, prefira provisionar PostgreSQL para que DATABASE_URL seja gerada.
DATABASE_URL=postgresql://usuario:senha@host:5432/cantinas_nexus

# Gere um valor aleatório longo no gerenciador de secrets do novo ambiente.
SESSION_SECRET=gere-um-segredo-aleatorio-no-gerenciador-de-secrets

# Desenvolvimento da API.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Desenvolvimento do frontend Vite.
# No artifact atual, o valor usado é BASE_PATH=/.
BASE_PATH=/
